{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,

    "types": ["node"],
    "lib": ["ES2022"],

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}